          "limes_code": "not_found"
        }
      ]
    },
    {
      "name": "a Biscuit copy",
      "as": "copy",
      "steps": [
        {
          "call": "lease",
          "of": "holder",
          "requests": 1,
          "code": "failed_precondition"
        }
      ]
    },
    {
      "name": "the holder's own Biscuit",
      "as": "biscuit",
      "steps": [
