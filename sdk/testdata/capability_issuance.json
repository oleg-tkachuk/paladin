{
  "_comment": "How CapabilityService answers Issue and Delegate where a consumer's tests meet it, which the server and both SDKs' fakes are held to. An issue case asks, for the fake's tenant, with audience [\"data\"], a TTL of 300 s, ops [\"get\", \"list\"] and unlimited ceilings unless it says otherwise: key_bound sets a confirmation_jkt, not_before is \"later\" (a minute on) or \"past_expiry\" (an hour on, past the TTL), no_request_ceiling and no_budget_ceiling leave a ceiling out. A delegate case delegates from a parent with parent_ops, its own caveats narrowed to child_ops when it names them and left out otherwise. want is the code it is refused with, or the biscuit_status it is answered with and whether a Biscuit comes back.",
  "issue": [
    {"name": "no share", "ops": ["get"], "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}},
    {"name": "share", "ops": ["get", "share"], "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}},
    {"name": "key-bound", "key_bound": true, "want": {"biscuit_status": "BISCUIT_STATUS_KEY_BOUND", "biscuit": false}},
    {"name": "not yet", "not_before": "later", "want": {"biscuit_status": "BISCUIT_STATUS_NOT_YET_VALID", "biscuit": false}},
    {"name": "past expiry", "not_before": "past_expiry", "want": {"code": "invalid_argument"}},
    {"name": "a bare op", "ops": ["get", "presign"], "want": {"code": "invalid_argument"}},
    {"name": "a misspelt op", "ops": ["Get"], "want": {"code": "invalid_argument"}},
    {"name": "no ops", "ops": [], "want": {"code": "invalid_argument"}},
    {"name": "a data-plane op", "ops": ["get", "object:presign"], "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}},
    {"name": "no request ceiling", "no_request_ceiling": true, "want": {"code": "invalid_argument"}},
    {"name": "no budget ceiling", "no_budget_ceiling": true, "want": {"code": "invalid_argument"}},
    {"name": "key-bound, required", "key_bound": true, "require_biscuit": true, "want": {"code": "failed_precondition"}},
    {"name": "not yet, required", "not_before": "later", "require_biscuit": true, "want": {"code": "failed_precondition"}},
    {"name": "a bare op, key-bound, required", "ops": ["presign"], "key_bound": true, "require_biscuit": true, "want": {"code": "failed_precondition"}},
    {"name": "past expiry, required", "not_before": "past_expiry", "require_biscuit": true, "want": {"code": "failed_precondition"}},
    {"name": "no share, required", "ops": ["get"], "require_biscuit": true, "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}}
  ],
  "delegate": [
    {"name": "the parent's caveats", "parent_ops": ["get", "share"], "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}},
    {"name": "a parent without share", "parent_ops": ["get"], "want": {"code": "permission_denied"}},
    {"name": "narrowed off share", "parent_ops": ["get", "share"], "child_ops": ["get"], "want": {"biscuit_status": "BISCUIT_STATUS_ISSUED", "biscuit": true}},
    {"name": "an op the parent lacks", "parent_ops": ["get", "share"], "child_ops": ["put"], "want": {"code": "permission_denied"}},
    {"name": "narrowed to a bare op", "parent_ops": ["get", "share"], "child_ops": ["presign"], "want": {"code": "invalid_argument"}},
    {"name": "wider and key-bound, required", "parent_ops": ["get", "share"], "child_ops": ["put"], "key_bound": true, "require_biscuit": true, "want": {"code": "failed_precondition"}},
    {"name": "a key-bound child, required", "parent_ops": ["get", "share"], "key_bound": true, "require_biscuit": true, "want": {"code": "failed_precondition"}}
  ]
}
