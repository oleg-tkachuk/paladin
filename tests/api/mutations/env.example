# gRPC Server Address
GRPC_ADDR="api.paladin.local:80"
GRPC_PLAINTEXT="true"

# Service configuration
AUTH_TOKEN="Bearer test-token"
TENANT_ID="test-tenant-1"
REQUEST_ID_PREFIX="test-run-"
TEST_TIMEOUT_SEC="10"

# Kubernetes configuration (for fetching logs)
KUBE_NAMESPACE="paladin"
KUBE_SELECTOR="app=paladin"
