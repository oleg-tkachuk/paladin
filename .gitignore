# Repo-root .gitignore for the Paladin monorepo. Path-specific ignores
# live in backend/ and frontend/ where applicable; this file covers
# the cross-cutting cases (compiled binaries, OS junk, dotenv files,
# IDE detritus that may land in either half or in tasks/).

# ── Compiled binaries (Go output anywhere in the tree) ──────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
server
!server/

# ── Coverage / profile output ───────────────────────────────────────
*.out
coverage.*
*.coverprofile
profile.cov

# ── Go workspace files ──────────────────────────────────────────────
go.work
go.work.sum

# ── Dotenv ──────────────────────────────────────────────────────────
.env
.env.*
!**/.env.example

# ── OS / editor cruft ───────────────────────────────────────────────
.DS_Store
Thumbs.db
# .idea/    # uncomment if any contributor commits IntelliJ project files
# .vscode/  # uncomment if any contributor commits VSCode workspace files

# ── Generated reports (when locally produced; CI uploads as artifacts) ─
backend/tests/grpcurl/reports/
backend/tests/api/mutations/reports/
backend/tests/api/security/reports/

# Claude worktrees
.claude/
.claude/*

# Hypothesis (Python property-based testing) runtime cache
.hypothesis/

# seed-fixture binary
backend/seed-fixture
backend/cmd/seed-fixture/main.go.bak


# Auto-generated build metadata; written by Taskfile's metadata:write
# task on every `task deploy`. Versions and timestamps go to git via
# tags + commit history, not via a tracked file.
**/deploy/info.env

# Task's fingerprint cache and remote-Taskfile cache.
**/.task/*
# ...except the remote lock. Task refuses to run when the content behind a
# ?ref= no longer matches it, which is the only thing standing between a
# moved tag and this build. Kept at any depth, because a component run from
# its own directory caches there rather than at the root.
!**/.task/remote/
**/.task/remote/*
!**/.task/remote/*.checksum
# ...and the module bodies themselves. Committing them is what lets
# TASK_OFFLINE=1 resolve every include from the repository: no clone, so no
# race over the one shared clone directory, no download timeout, and a build
# that does not depend on github.com being reachable. The .timestamp files stay
# out - they are per-machine cache state, not content.
!**/.task/remote/*.yaml

# ── Release tooling (root package.json: semantic-release only) ──────
/node_modules/

docs/BACKLOG.md

# Local-only lefthook overrides. Gates that belong to a working copy rather
# than to the project; lefthook merges the file automatically when present.
lefthook-local.yml

# Claude Code's working state on this machine: agent worktrees, each a full
# checkout of the repository on its own branch, and the tool's bookkeeping.
# Nothing in it is project configuration, so the directory is ignored whole.
.claude/

