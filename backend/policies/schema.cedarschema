// Cedar schema for Paladin authorization model.
//
// Describes what internal/policy/cedar/engine.go emits: the Action constants,
// the entities built by buildEntities, and the context built by buildContext.
// internal/policy/cedar/schema_test.go fails when the two disagree.
//
// Hierarchy:
//   StorageBackend
//   └── Bucket
//        └── Collection           ← parent is BOTH Bucket and Tenant
//             └── Object
//   Tenant
//   └── Collection
//   └── User                     (principal keyed by subject; resource keyed by tenant/user)
//
// Roles (canonical dot-form, mirrored in defaultpolicy.go):
//   platform.admin             — cross-tenant superuser
//   platform.tenant-provisioner — creates tenants and their storage
//   platform.capability-issuer — issues capabilities for any tenant
//   tenant.admin               — tenant-scoped admin
//   bucket.admin               — bucket configuration
//   compliance.officer         — Object Lock / immutability
//   secrets.rotator            — credential rotation only
//   policy.author              — policy introspection
//
// Action plane mapping:
//   * Admin (control plane) — backends, buckets, tenants, collections, quotas,
//     subscriptions, audit log, operations, billing, capabilities, API tokens,
//     MCP inspection.
//   * Data plane — object operations, Object Lock, tenant storage bootstrap.
//   * IAM (iam plane) — users, user settings, OAuth consent.
//   * Inspection — policy validation / simulation / effective-policy lookup.

// ─── Context ────────────────────────────────────────────────────────────────

// Every request carries the same context; fields that do not apply to an
// action are zero-valued.
type RequestContext = {
  size_bytes: Long,
  content_type: String,
  now: Long,
  ip: String,
  oauth_client_id: String,
  oauth_scopes: Set<String>,
};

// ─── Entities ───────────────────────────────────────────────────────────────

// scope_keys on a resource-side entity is the set of scope strings that admit
// it (tenant:/backend:/bucket:/collection:). The built-in scope-enforcement
// policy intersects principal.scopes with it.

entity StorageBackend = {
  backend_id: String,
  scope_keys: Set<String>,
};

entity Bucket in [StorageBackend] = {
  bucket_name: String,
  backend_id: String,
  owner_tenant_id: String,
  labels: Set<String>,
  scope_keys: Set<String>,
};

// The UID is the slug when the tenant has one, the UUID otherwise. A Tenant
// built only to anchor a principal from another tenant has no scope_keys.
entity Tenant = {
  tenant_id: String,
  slug: String,
  display_name: String,
  labels: Set<String>,
  scope_keys?: Set<String>,
};

entity Collection in [Tenant, Bucket] = {
  collection: String,
  tenant_id: String,
  bucket_name: String,
  backend_id: String,
  scope_keys: Set<String>,
};

entity Object in [Collection] = {
  key: String,
  state: String,
  size_bytes: Long,
  content_type: String,
  tenant_id: String,
  collection: String,
  bucket_name: String,
  backend_id: String,
  tags: Set<String>,
  scope_keys: Set<String>,
  // The engine also sets `tag_values`, a Record of tag name → tag value, so a
  // policy can test a tag's value:
  //   resource.tag_values has "classified" && resource.tag_values["classified"] == "true"
  // A Cedar record type is closed and the keys are the object's own tag
  // names, so it cannot be declared here: it exists at authorization time
  // and is invisible to schema validation. Use `has` before indexing — a
  // missing key is an evaluation error, and Cedar denies on those.
};

// User is both the principal (UID = subject) and the resource of user and
// user-settings actions (UID = tenant_id/user_id). The two carry the same
// attributes; the ones that belong to the other family are zero-valued.
entity User in [Tenant] = {
  tenant_id: String,
  subject: String,
  // Principal side.
  tenant_slug: String,
  // Credential type behind the principal: "user" | "api_key" |
  // "service_account" | "capability". Empty when the authorizing path does
  // not carry it.
  kind: String,
  roles: Set<String>,
  // Wire-form scopes from the token. Empty for role-only principals.
  scopes: Set<String>,
  // Resource side.
  user_id: String,
  scope_keys?: Set<String>,
};

// ─── Actions ────────────────────────────────────────────────────────────────

// Backend (admin plane).
action "ManageBackend", "RotateBackendCredentials" appliesTo {
  principal: [User],
  resource: [StorageBackend],
  context: RequestContext
};

// ListBackends has no backend to name, so it is checked against the Tenant.
action "ReadBackend" appliesTo {
  principal: [User],
  resource: [StorageBackend, Tenant],
  context: RequestContext
};

// Bucket (admin plane). Coarse Manage/Read + granular Configure* sub-actions.
action "ManageBucket",
       "ConfigureBucketPolicy", "ConfigureLifecycle", "ConfigureLock",
       "ConfigureVersioning", "ConfigureReplication" appliesTo {
  principal: [User],
  resource: [Bucket],
  context: RequestContext
};

// ListBuckets is checked against the StorageBackend it names, or the Tenant
// when it names none.
action "ReadBucket" appliesTo {
  principal: [User],
  resource: [Bucket, StorageBackend, Tenant],
  context: RequestContext
};

// Collection (admin plane). ListCollections is checked against the Tenant.
action "ManageCollection" appliesTo {
  principal: [User],
  resource: [Collection, Tenant],
  context: RequestContext
};

action "BindCollectionToBucket" appliesTo {
  principal: [User],
  resource: [Collection],
  context: RequestContext
};

// Tenant (admin plane). Also the resource for tenant-scoped records that have
// no entity of their own: audit log, event subscriptions, operations, billing.
action "ManageTenant", "ReadTenant",
       "ResetQuotaUsage",
       "ReadAuditLog", "ExportAuditLog",
       "ManageSubscription", "ReadSubscription", "TestSubscription",
       "ReadOperation", "CancelOperation",
       "ReadBilling" appliesTo {
  principal: [User],
  resource: [Tenant],
  context: RequestContext
};

// A quota attaches to a tenant or to a bucket.
action "ManageQuota", "ReadQuota" appliesTo {
  principal: [User],
  resource: [Tenant, Bucket],
  context: RequestContext
};

// Policy inspection names a tenant or one of its collections.
action "InspectPolicy" appliesTo {
  principal: [User],
  resource: [Tenant, Collection],
  context: RequestContext
};

// Capabilities and API tokens (admin plane). Checked against the CALLER's own
// tenant; which other tenants a call may reach is decided in the handler.
// The two credential types have separate actions so a grant on one never
// carries over to the other.
action "IssueCapability", "DelegateCapability", "RevokeCapability",
       "ReadCapability",
       "CreateAPIToken", "RevokeAPIToken", "ReadAPIToken" appliesTo {
  principal: [User],
  resource: [Tenant],
  context: RequestContext
};

// MCP inspection (admin plane): sessions, profiles, tool catalog, bridge
// status. Read-only; checked against the caller's own tenant.
action "InspectMCP" appliesTo {
  principal: [User],
  resource: [Tenant],
  context: RequestContext
};

// EnsureTenantStorage (data plane). Self-service storage provisioning: a
// tenant member ensures its own bucket and collections. The handler pins the
// resource to the caller's tenant.
action "EnsureTenantStorage" appliesTo {
  principal: [User],
  resource: [Tenant],
  context: RequestContext
};

// OAuth consent (ADR-0009), checked at /oauth/authorize. context carries
// oauth_client_id and oauth_scopes so a tenant can forbid specific clients.
action "AuthorizeOAuth" appliesTo {
  principal: [User],
  resource: [Tenant],
  context: RequestContext
};

// Data plane. Write actions fill size_bytes / content_type in the context so
// policies can cap uploads.
//
// The actions on [Object, Collection] are also checked against the Collection
// when no object key is known at authorization time: batch operations (a batch
// copy checks PutObject on the destination), list and count. A policy that reads
// resource.key for them must guard it with `resource has key`.
action "PutObject", "GetObject",
       "DeleteObject", "RestoreObject", "UpdateObject", "CopyObject" appliesTo {
  principal: [User],
  resource: [Object, Collection],
  context: RequestContext
};

action "PresignPut", "PresignGet", "HeadObject" appliesTo {
  principal: [User],
  resource: [Object],
  context: RequestContext
};

// Object Lock (ADR-0013). Separate from UpdateObject because setting a
// retention window is not an ordinary edit: a COMPLIANCE lock cannot be
// shortened by anyone, so whoever holds this action can make an object — and
// the storage it occupies — permanently undeletable. Granting write access to
// a collection should not carry that.
//
// SetObjectLegalHold is split from SetObjectRetention for the same reason in
// the other direction: a hold is reversible, so it can be delegated more
// freely to whoever answers a legal request.
action "SetObjectRetention", "SetObjectLegalHold", "ReadObjectLock" appliesTo {
  principal: [User],
  resource: [Object],
  context: RequestContext
};

// SetObjectTaint flags or clears the signals that keep an object's content
// from agents not allowed to read flagged content. Clearing one re-opens the
// content, so it is not implied by write access.
action "SetObjectTaint" appliesTo {
  principal: [User],
  resource: [Object],
  context: RequestContext
};

// IAM — user management. Listing is checked against the Tenant.
action "ManageUser", "ResetPassword", "GrantScopes" appliesTo {
  principal: [User],
  resource: [User],
  context: RequestContext
};

action "ReadUser" appliesTo {
  principal: [User],
  resource: [User, Tenant],
  context: RequestContext
};

// IAM — user settings. The handler allows a user's own settings without a
// Cedar call; Cedar gates reading or changing another user's. Listing a
// tenant's settings is checked against the Tenant.
action "ReadUserSettings" appliesTo {
  principal: [User],
  resource: [User, Tenant],
  context: RequestContext
};

action "ManageUserSettings" appliesTo {
  principal: [User],
  resource: [User],
  context: RequestContext
};
