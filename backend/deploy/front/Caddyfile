# The console's one origin in the compose stacks, as the chart's ingress
# makes it on a cluster (ADR-0048): /session/* to the session role, everything
# else to the console. The session cookie is __Host- and the session role
# checks Origin against the host it is called on, so both halves must be the
# same origin. Caddy passes the Host through and sets X-Forwarded-Host.
{
	admin off
	auto_https off
}

:{$FRONT_PORT} {
	handle /session/* {
		reverse_proxy {$SESSION_UPSTREAM}
	}
	handle {
		reverse_proxy {$CONSOLE_UPSTREAM}
	}
}
