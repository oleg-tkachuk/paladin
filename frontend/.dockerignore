# Build context for deploy/Dockerfile (`docker build .` from frontend/).
# The Dockerfile's `COPY . .` line copies *everything* not excluded
# here into the builder stage; lean rules → smaller context → faster
# builds and smaller cached layers.
#
# Keep:
#   - source dirs (src/, public/, configs/)
#   - lockfile + manifest (package.json, pnpm-lock.yaml,
#     pnpm-workspace.yaml) for `pnpm install --frozen-lockfile`
#   - build configs (next.config.ts, tsconfig.json, eslint.config.mjs,
#     postcss.config.mjs, components.json, tailwind config)
#   - codegen inputs (buf.gen.yaml, scripts/, tasks/)
# Everything else is excluded by the rules below.

# ── Self-reference ──────────────────────────────────────────────────
# Including the Dockerfile / .dockerignore in the image is harmless
# but noisy; excluding them keeps the layer hash stable across edits
# to unrelated build instructions.
.dockerignore
deploy/Dockerfile
deploy/docker-compose.yaml
deploy/chart/

# ── Dependencies (re-installed in the deps stage) ───────────────────
node_modules/
.pnp/
.pnp.js
.yarn/

# ── Build outputs (re-emitted by `next build`) ──────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
# next-env.d.ts is auto-regenerated by `next build`.
next-env.d.ts

# ── Test / lint caches and reports ──────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
.eslintcache

# ── Secrets / local-only ────────────────────────────────────────────
# Allow the example so build-time docs render; deny everything else.
.env
.env.*
!.env.example

# ── VCS / CI metadata ───────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/

# ── Editor / OS / agent detritus ────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.claude/
.agents/

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Repo-tooling configs not needed at build time ───────────────────
lefthook.yml
release.config.cjs
README.md
CHANGELOG.md
CLAUDE.md
skills-lock.json
