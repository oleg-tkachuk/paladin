{
  "name": "paladin-console",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bash scripts/serve-export.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate": "buf generate --include-imports && prettier --write src/gen",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:stack": "docker compose -p paladin-e2e -f tests/e2e/docker-compose.test.yaml up",
    "test:e2e:stack:down": "docker compose -p paladin-e2e -f tests/e2e/docker-compose.test.yaml down -v",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@heroicons/react": "^2.2.0",
