  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate": "buf generate --include-imports && prettier --write src/gen",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:stack": "docker compose -p paladin-e2e -f tests/e2e/docker-compose.test.yaml up",
    "test:e2e:stack:down": "docker compose -p paladin-e2e -f tests/e2e/docker-compose.test.yaml down -v",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
