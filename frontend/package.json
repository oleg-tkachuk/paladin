    "geist": "^1.8.2",
    "jose": "6.2.14",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
