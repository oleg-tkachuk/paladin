{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource holding Paladin's metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Background work and dependencies: outbox, workers, Postgres, rate limiting, presigns, capability charges. RPC traffic is on the RPC RED dashboard. See README.md.",
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "paladin",
    "operations"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "refresh": "1m",
  "title": "Paladin — Operations",
  "uid": "paladin-operations",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "${DS_PROMETHEUS}"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Outbox backlog",
      "description": "Outbox rows the dispatcher has not delivered yet (ADR-0003). A value that climbs and stays up means events are written faster than they are delivered: subscribers fall behind while RPCs still succeed.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "max(paladin_outbox_pending)",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Stalled workers",
      "description": "Workers whose last completed tick is older than twice their own interval. Both values come from the worker, so a changed schedule does not count; a worker that stopped does.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "count((time() - paladin_worker_last_run_timestamp_seconds) > (2 * paladin_worker_interval_seconds)) or vector(0)",
          "legendFormat": "stalled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Postgres errors (5m)",
      "description": "Failed database operations recorded by otelpgx.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum(increase(db_client_operation_errors_total[5m])) or vector(0)",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Rate limiting failing open (15m)",
      "description": "Requests admitted because the rate limiter's own storage failed. While non-zero, the per-tenant or per-token ceiling is not enforced.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "(sum(increase(paladin_tenant_ratelimit_fail_open_total[15m])) or vector(0)) + (sum(increase(paladin_api_token_ratelimit_fail_open_total[15m])) or vector(0))",
          "legendFormat": "fail-open"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Outbox depth",
      "description": "Total pending beside the deepest single-tenant backlog. A high total with a low per-tenant maximum points at the dispatcher; a per-tenant maximum close to the total points at one tenant's sink.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "max(paladin_outbox_pending)",
          "legendFormat": "total pending"
        },
        {
          "datasource": "${datasource}",
          "expr": "max(paladin_outbox_pending_max_per_tenant)",
          "legendFormat": "deepest tenant"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Worker ticks by outcome",
      "description": "Tick rate per worker and outcome. A worker that disappears from this chart has stopped ticking, which no error rate shows.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (worker, outcome) (rate(paladin_worker_runs_total[$__rate_interval]))",
          "legendFormat": "{{worker}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Worker tick duration p95",
      "description": "Tick duration per worker. A duration approaching the worker's interval means ticks start late and its backlog does not empty.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(paladin_worker_run_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Postgres operation latency p95",
      "description": "Latency per pgx operation type from otelpgx. acquire rising while query stays flat indicates pool exhaustion rather than slow SQL.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (le, pgx_operation_type) (rate(db_client_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{pgx_operation_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Per-tenant rate-limit decisions",
      "description": "Requests admitted and refused by the per-tenant limiter. A refused tenant receives ResourceExhausted.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum(rate(paladin_tenant_ratelimit_decisions_total{allowed=\"true\"}[$__rate_interval]))",
          "legendFormat": "admitted"
        },
        {
          "datasource": "${datasource}",
          "expr": "sum by (tenant_id) (rate(paladin_tenant_ratelimit_decisions_total{allowed=\"false\"}[$__rate_interval]))",
          "legendFormat": "refused {{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Capability charges by outcome",
      "description": "Charge attempts made under a capability. outcome is charged, capability_exhausted, tenant_exhausted or error.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (outcome) (rate(paladin_capability_charges_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Presigns by op and outcome",
      "description": "Presigned URLs issued, by op (get, put, post, part) and outcome (ok or a Connect code). Object bytes do not pass through Paladin, so this is the transfer rate the control plane sees.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (op, outcome) (rate(paladin_presign_total[$__rate_interval]))",
          "legendFormat": "{{op}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Presign latency p95 by op",
      "description": "Time to issue a presigned URL, including the bucket lookup and the policy decision. Signing is local, so this measures Postgres and Cedar, not the object store.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (le, op) (rate(paladin_presign_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Refused capability charges by tenant",
      "description": "Every outcome except charged, per tenant. Empty is the normal state.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (tenant_id, outcome) (rate(paladin_capability_charges_total{outcome!=\"charged\"}[$__rate_interval]))",
          "legendFormat": "{{tenant_id}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "id": 13
    }
  ]
}
