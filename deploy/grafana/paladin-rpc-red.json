{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the OTLP collector's exported Paladin RPC metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "RED (Rate / Errors / Duration) for every Paladin Connect RPC, sourced from the otelconnect rpc.server.* metrics activated by ADR-0001. See README.md for metric-name / datasource assumptions.",
  "editable": true,
  "graphTooltip": 1,
  "tags": ["paladin", "rpc", "red"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(rpc_server_duration_milliseconds_count, rpc_service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Paladin — RPC RED",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Request rate (req/s) by service",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (rpc_service) (rate(rpc_server_duration_milliseconds_count{rpc_service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_service}}"
        }
      ]
    },
    {
      "title": "Error rate (% of requests with a Connect error code)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (rpc_service) (rate(rpc_server_duration_milliseconds_count{rpc_service=~\"$service\", rpc_connect_rpc_error_code!=\"\"}[$__rate_interval])) / clamp_min(sum by (rpc_service) (rate(rpc_server_duration_milliseconds_count{rpc_service=~\"$service\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{rpc_service}}"
        }
      ]
    },
    {
      "title": "Latency p50 / p95 / p99 (all services, ms)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rpc_server_duration_milliseconds_bucket{rpc_service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_duration_milliseconds_bucket{rpc_service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_duration_milliseconds_bucket{rpc_service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "p99 latency by method (ms)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "histogram_quantile(0.99, sum by (le, rpc_service, rpc_method) (rate(rpc_server_duration_milliseconds_bucket{rpc_service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{rpc_service}}/{{rpc_method}}"
        }
      ]
    }
  ]
}
